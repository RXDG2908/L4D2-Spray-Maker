{
  "name": "l4d2-spray-maker",
  "version": "1.3.0",
  "private": false,
  "type": "module",
  "description": "Crea sprays estaticos y animados (.vtf) para Left 4 Dead 2 desde fotos, videos y GIF, y los instala directamente en el juego.",
  "author": "RXDG2908",
  "license": "MIT",
  "homepage": "https://github.com/RXDG2908/L4D2-Spray-Maker",
  "repository": {
    "type": "git",
    "url": "https://github.com/RXDG2908/L4D2-Spray-Maker.git"
  },
  "bugs": {
    "url": "https://github.com/RXDG2908/L4D2-Spray-Maker/issues"
  },
  "keywords": [
    "left4dead2",
    "l4d2",
    "spray",
    "vtf",
    "source-engine",
    "valve"
  ],
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "build": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "multer": "^2.0.0",
    "vtf-js": "^0.9.4",
    "vtf-js-decoder": "npm:vtf-js@^1.1.5"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.rxdg2908.l4d2spraymaker",
    "productName": "L4D2 Spray Maker",
    "copyright": "Copyright (c) 2026 RXDG2908",
    "files": [
      "electron/**/*",
      "public/**/*",
      "src/**/*",
      "server.js",
      "!**/*.map",
      "!node_modules/ffprobe-static/bin/darwin${/*}",
      "!node_modules/ffprobe-static/bin/linux${/*}",
      "!node_modules/ffprobe-static/bin/win32/ia32${/*}"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "RXDG2908",
        "repo": "L4D2-Spray-Maker"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis-web",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "L4D2 Spray Maker"
    },
    "nsisWeb": {
      "artifactName": "L4D2-Spray-Maker-Setup-${version}.${ext}"
    }
  }
}
